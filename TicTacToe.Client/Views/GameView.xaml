<UserControl x:Class="TicTacToe.Client.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Игровое поле -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding Error}" Foreground="#E11D48" Margin="0,0,0,16"
                       Width="320" MaxWidth="320"
                       TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Обертка Grid для наложения линии поверх кнопок -->
            <Grid Width="336" Height="336">
                <ItemsControl ItemsSource="{Binding Board}" IsEnabled="{Binding CanClick}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="3" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ClickCommand}"
                                    Width="100" Height="100" Margin="6"
                                    FontSize="48" FontWeight="Bold"
                                    Background="{StaticResource CellBgColor}"
                                    Foreground="Black">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderBrush="{StaticResource BorderColor}" 
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center">
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    </Style>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="{StaticResource CellBgColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding Display}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Сплошная линия победы -->
                <Line X1="{Binding LineX1}" Y1="{Binding LineY1}" 
                      X2="{Binding LineX2}" Y2="{Binding LineY2}" 
                      Stroke="#E11D48" StrokeThickness="8" 
                      IsHitTestVisible="False"
                      Visibility="{Binding ShowWinLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="Играть ещё"
                        Command="{Binding ResetSessionCommand}"
                        Visibility="{Binding CanRestart, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        Padding="18,9"
                        FontSize="15"
                        FontWeight="SemiBold"/>
                <Button Content="Выйти из игры"
                        Command="{Binding LeaveSessionCommand}"
                        MinWidth="150"
                        Padding="18,9"
                        FontSize="15"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <!-- Чат -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="24,0,0,0">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="Чат" 
                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="→" Width="40" Margin="8,0,0,0"
                            Command="{Binding SendChatCommand}"/>
                </Grid>

                <ListBox ItemsSource="{Binding Chat}" BorderThickness="0" 
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock>
                                    <Run Text="{Binding Author}" FontWeight="SemiBold" 
                                         FontSize="12" Foreground="#64748B"/>
                                    <Run Text="{Binding Timestamp, StringFormat=HH:mm}" 
                                         FontSize="11" Foreground="#94A3B8"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" 
                                           FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>