<UserControl x:Class="TicTacToe.Client.Views.MiniGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TicTacToe.Client.Converters">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="Жеребьёвка" FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Text="{Binding Status}" Margin="0,0,0,32" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center" FontSize="16" Foreground="#64748B"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Button Content="Орёл" Width="160" Height="56" Margin="0,0,16,0" FontSize="18"
                    Command="{Binding ChooseHeadsCommand}"
                    IsEnabled="{Binding CanChooseHeads}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Решка" Width="160" Height="56" FontSize="18"
                    Command="{Binding ChooseTailsCommand}"
                    IsEnabled="{Binding CanChooseTails}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <TextBlock Text="{Binding MySymbol}" Margin="0,0,0,8"
                   FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding MyTurnInfo}" FontSize="16" 
                   Foreground="#64748B" HorizontalAlignment="Center"/>

        <Button Content="Выйти из игры"
                Command="{Binding LeaveSessionCommand}"
                HorizontalAlignment="Center"
                MinWidth="150"
                Margin="0,24,0,0"
                Padding="18,9"
                FontSize="15"/>
    </StackPanel>
</UserControl>