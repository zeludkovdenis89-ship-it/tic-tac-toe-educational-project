<UserControl x:Class="TicTacToe.Client.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="White" CornerRadius="12" Padding="40" 
                Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Тень для карточки -->
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Крестики-нолики" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Командная сетевая версия" FontSize="14" Foreground="#64748B" 
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Подключение -->
                <TextBlock Text="Сервер" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                             Width="70" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Подключиться" Command="{Binding ConnectCommand}"/>
                </Grid>

                <!-- Действия -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Обновить список" 
                            Command="{Binding RefreshSessionsCommand}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Создать сессию" 
                            Command="{Binding CreateSessionCommand}"/>
                </Grid>

                <!-- Список сессий -->
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                        CornerRadius="8" Height="180" Margin="0,0,0,16">
                    <ListBox ItemsSource="{Binding Sessions}" BorderThickness="0" 
                             Background="Transparent" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="8,4">
                                    <Button DockPanel.Dock="Right" Content="Войти" Width="60" 
                                            Padding="8,4" FontSize="12"
                                            Command="{Binding DataContext.JoinSessionCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Ошибки -->
                <TextBlock Text="{Binding Error}" Foreground="#E11D48" TextWrapping="Wrap" 
                           HorizontalAlignment="Center" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>