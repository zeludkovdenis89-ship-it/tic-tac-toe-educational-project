<Window x:Class="TicTacToe.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TicTacToe.Client.ViewModels"
        xmlns:views="clr-namespace:TicTacToe.Client.Views"
        Title="Крестики-нолики"
        Width="1024" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgColor}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LobbyViewModel}">
            <views:LobbyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MiniGameViewModel}">
            <views:MiniGameView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GameView/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding Current}"/>
</Window>